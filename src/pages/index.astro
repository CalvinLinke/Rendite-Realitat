---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import ArticleCard from "../components/ArticleCard.astro";
import CompanyCard from "../components/CompanyCard.astro";
import LeadCard from "../components/LeadCard.astro";
import SectionHeader from "../components/SectionHeader.astro";
import { companies, site } from "../data/site";

const journal = (await getCollection("journal")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const featured = journal.filter((entry) => entry.data.featured).slice(0, 3);
const latest = journal.slice(0, 6);
const leadMagnets = (await getCollection("mehrwerte")).slice(0, 2);
---

<BaseLayout title={site.name} description={site.description}>
  <section class="hero">
    <div>
      <p class="eyebrow">Immobilien · Unternehmertum · echte Erfahrungen</p>
      <h1>{site.claim}</h1>
      <p>
        Ich nehme dich mit auf meine Reise als junger Unternehmer im
        Immobilienbereich. Mit Entscheidungen, Fehlern, Erfolgen und Learnings
        aus der Praxis.
      </p>
      <div class="hero-actions">
        <a class="button" href="/meine-reise">Meine Reise lesen</a>
        <a class="button-secondary" href="/mehrwerte">Kostenlose Mehrwerte</a>
      </div>
    </div>
    <div class="hero-image">
      <img src="/images/portraits/calvin-portrait.jpg" alt="Calvin Linke" />
      <p class="hero-note">
        Kein perfekter Ratgeber von oben herab. Sondern ein ehrlicher Blick auf
        das, was in Immobilienprojekten und beim Aufbau von Unternehmen wirklich
        passiert.
      </p>
    </div>
  </section>

  <section class="band">
    <div class="section-tight">
      <SectionHeader
        eyebrow="Aktuell"
        title="Neue Einblicke aus dem Journal"
        text="Die Website lebt von echten Geschichten: was funktioniert, was schiefgeht und was man daraus lernen kann."
      />
      <div class="grid">
        {featured.map((entry) => (
          <ArticleCard
            href={`/journal/${entry.id}`}
            title={entry.data.title}
            description={entry.data.description}
            category={entry.data.category}
            date={entry.data.date}
            image={entry.data.image}
          />
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="split">
      <div>
        <p class="eyebrow">Worum es hier geht</p>
        <h2>Mehr Realität hinter der Rendite.</h2>
      </div>
      <div>
        <p>
          Immobilien wirken von außen oft einfacher, als sie in der Praxis sind.
          Genau deshalb geht es hier nicht nur um Ergebnisse, sondern um den
          Weg dorthin: Entscheidungen, Gespräche, Sanierungen, Zahlen,
          Rückschläge und die Menschen dahinter.
        </p>
        <p>
          Rendite & Realität soll Orientierung geben, ohne schnelle Versprechen
          zu machen. Verständlich, bodenständig und nah an echten Projekten.
        </p>
      </div>
    </div>
  </section>

  <section class="band">
    <div class="section">
      <SectionHeader
        eyebrow="Themen"
        title="Drei Blickwinkel, ein ehrlicher Ansatz"
        text="Die Inhalte sind so aufgebaut, dass sie für angehende Anleger, Eigentümer und unternehmerisch denkende Leser verständlich bleiben."
      />
      <div class="grid">
        <article class="plain-card">
          <h3>Immobilienwissen</h3>
          <p>
            Einfache Einordnung zu Rendite, Risiko, Standort, Sanierung,
            Bewertung und Verkaufsfragen.
          </p>
          <a class="button-secondary" href="/immobilienwissen">Wissen lesen</a>
        </article>
        <article class="plain-card">
          <h3>Erfahrungen</h3>
          <p>
            Konkrete Geschichten aus Projekten, Entscheidungen und Momenten, in
            denen Realität wichtiger war als der Plan.
          </p>
          <a class="button-secondary" href="/erfahrungen">Erfahrungen lesen</a>
        </article>
        <article class="plain-card">
          <h3>Mehrwerte</h3>
          <p>
            Checklisten, Roadmaps und praktische Unterlagen für Käufer,
            Eigentümer und Menschen, die strukturierter entscheiden wollen.
          </p>
          <a class="button-secondary" href="/mehrwerte">Mehrwerte ansehen</a>
        </article>
      </div>
    </div>
  </section>

  <section class="section">
    <SectionHeader
      eyebrow="Kostenlose Mehrwerte"
      title="Praktische Inhalte ohne Verkaufsdruck"
      text="Die ersten Inhalte sind bewusst einfach gehalten: klare Schritte, typische Fehler und Entscheidungshilfen."
    />
    <div class="grid-two">
      {leadMagnets.map((entry) => (
        <LeadCard
          href={`/mehrwerte/${entry.id}`}
          title={entry.data.title}
          description={entry.data.description}
          type={entry.data.type}
        />
      ))}
    </div>
  </section>

  <section class="band">
    <div class="section">
      <SectionHeader
        eyebrow="Unternehmensgruppe"
        title="Aus Ideen sind eigene Aufgaben geworden"
        text="Die Unternehmen sind nicht als fertiger Plan entstanden. Viele Dinge haben sich aus der Praxis heraus entwickelt."
      />
      <div class="grid">
        {companies.map((company) => <CompanyCard company={company} />)}
      </div>
    </div>
  </section>

  <section class="section">
    <SectionHeader
      eyebrow="Journal"
      title="Weitere Beiträge"
      text="Alle Texte sind darauf ausgelegt, Dinge verständlich zu machen und ehrlich einzuordnen."
    />
    <div class="grid">
      {latest.map((entry) => (
        <ArticleCard
          href={`/journal/${entry.id}`}
          title={entry.data.title}
          description={entry.data.description}
          category={entry.data.category}
          date={entry.data.date}
          image={entry.data.image}
        />
      ))}
    </div>
  </section>
</BaseLayout>
