---
interface Props {
  href: string;
  title: string;
  description: string;
  category: string;
  date?: Date | string;
  image?: string;
}

const { href, title, description, category, date, image } = Astro.props;
const formattedDate = date
  ? new Intl.DateTimeFormat("de-DE", {
      day: "2-digit",
      month: "long",
      year: "numeric"
    }).format(new Date(date))
  : "";
---

<a class="article-card" href={href}>
  {image && <img src={image} alt="" loading="lazy" />}
  <span>{category}{formattedDate ? ` · ${formattedDate}` : ""}</span>
  <h3>{title}</h3>
  <p>{description}</p>
</a>
