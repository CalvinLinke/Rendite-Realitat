---
import { footerItems, navItems, site } from "../data/site";
---

<footer class="site-footer">
  <div class="footer-brand">
    <p class="footer-title">{site.name}</p>
    <p>
      © 2026 Rendite & Realität. Persönliche Dokumentation von Business,
      Immobilien und echten Entscheidungen.
    </p>
  </div>
  <nav class="footer-links" aria-label="Fußnavigation">
    {[...navItems, ...footerItems].map((item) => <a href={item.href}>{item.label}</a>)}
  </nav>
</footer>
